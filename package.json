{
  "name": "@openasy/auth",
  "version": "0.11.1",
  "description": "Sign-in shared by every OpenAsy product: local accounts, MFA (TOTP and passkeys), OIDC, sessions, members and scoped API tokens.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openasy/auth.git"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "prettier": "@openasy/code-style/prettier",
  "engines": {
    "node": ">=26.12.0",
    "npm": ">=11"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "lucide-react": "^1.60.0",
    "openid-client": "^6.8.8",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@levischuck/tiny-cbor": "^0.3.6",
    "@openasy/code-style": "https://github.com/openasy/code-style/releases/download/v0.1.2/openasy-code-style-0.1.2.tgz",
    "@openasy/ui": "https://github.com/openasy/ui/releases/download/v0.9.0/openasy-ui-0.9.0.tgz",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "jose": "^6.2.13",
    "jsdom": "^30.1.3",
    "oxlint": "1.87.0",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@openasy/ui": ">=0.6.0",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "@openasy/ui": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
